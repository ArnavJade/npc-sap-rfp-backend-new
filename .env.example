# =============================================================================
# Models (LiteLLM model strings; any provider LiteLLM supports)
# =============================================================================
# Default model for every agent. Examples:
#   gemini/gemini-3.8-flash                      (needs GEMINI_API_KEY)
#   bedrock/<inference-profile-or-model-id>      (needs AWS creds or AWS_BEARER_TOKEN_BEDROCK + AWS_REGION_NAME)
#   anthropic/<model-id>                         (needs ANTHROPIC_API_KEY)
LLM_MODEL=
# Optional per-role overrides (roles: orchestrator, analyst, specialist, mapper, planner, writer, reviewer, vision)
# LLM_MODEL_ORCHESTRATOR=
# LLM_MODEL_WRITER=
# LLM_TEMPERATURE=0.1

# Provider credentials (set the ones your models need)
# GEMINI_API_KEY=
# AWS_REGION_NAME=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ANTHROPIC_API_KEY=

# =============================================================================
# Runtime
# =============================================================================
# WORKSPACE_DIR=workspace
# MAX_CONCURRENT_JOBS=2
# INGEST_PDF_ENGINE=pymupdf4llm        # pymupdf4llm | docling (pip install .[docling])
# INGEST_VISION=on                     # default on: caption embedded images with the 'vision' role model (off to skip)
# LOG_LEVEL=INFO                      # DEBUG also shows LiteLLM/httpx internals and per-call model logs
# LOG_FORMAT=text                     # text | json (one JSON object per line, for log shippers)
# LOG_DIR=workspace/logs              # app.log (rotating 20 MB x 5); each bid also gets trace/run.log
# TRACE_PREVIEW_CHARS=1500            # size of output / argument previews stored in trace events
# TRACE_LLM_CONTENT=on                # off: llm_calls.jsonl keeps metadata only (no prompt / response text)
# TRACE_LOG_CALLS=on                  # off: model and tool call events log at DEBUG instead of INFO

# =============================================================================
# Platform (optional - only the /pipeline/* routes use these)
# =============================================================================
# SharePoint (Microsoft Graph, app-only auth)
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
AZ_SHAREPOINT_HOSTNAME=
AZ_SHAREPOINT_SITE_PATH=
SHAREPOINT_ROOT_FOLDER=
# Activity API (leave empty to disable activity reporting)
ACTIVITY_API_BASE_URL=
# ACTIVITY_API_MAX_RETRIES=3
# ACTIVITY_API_TIMEOUT=5
